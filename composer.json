{
    "name": "faster-php/data-model",
    "description": "Faster PHP data models with sorting, pagination and validation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcus Don",
            "email": "marcus@fasterphp.com"
        }
    ],
    "homepage": "https://github.com/FasterPHP/data-model",
    "support": {
        "issues": "https://github.com/FasterPHP/data-model/issues",
        "source": "https://github.com/FasterPHP/data-model"
    },
    "keywords": [
        "data-model",
        "active-record",
        "repository",
        "pdo",
        "mysql",
        "mariadb",
        "lazy-loading",
        "pagination",
        "validation"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "faster-php/db": "^2.0@rc",
        "laminas/laminas-validator": "^2.38",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest",
        "symfony/validator": "^7.4",
        "illuminate/validation": "^12.69"
    },
    "suggest": {
        "laminas/laminas-validator": "Required to use Validation\\LaminasValidatorTrait",
        "faster-php/db": "PDO drop-in with lazy connect, auto-reconnect and statement caching"
    },
    "autoload": {
        "psr-4": {
            "FasterPhp\\DataModel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FasterPhp\\DataModel\\": "tests/"
        }
    }
}
